
import java.io.File;
import org.eclipse.emf.ecore.util.EcoreUtil;

import "http://vitruv.tools/methodologisttemplate/model" as model
import "http://vitruv.tools/methodologisttemplate/model2" as model2

reactions: model2Model2
in reaction to changes in model
execute actions in model2

// insert a System, which is the root element of model, into an instance of model
// as a reaction, an element of type Root should be created, persisted relatively, 
// and a correspondence should be added (see the called routine)
reaction SystemInsertedAsRoot {
	after element model::System inserted as root
  // newValue refers to the newly inserted element of type System (provided by the reactions runtime environment at runtime)
	call createAndRegisterRoot(newValue)
}

routine createAndRegisterRoot(model::System system) {
	match {
    // we do only want to create a new corresponding Root if we not have one already and the old one has, e.g., only been moved
		require absence of model2::Root corresponding to system
	}
  create {
    // short way of using the respective Factory calls, which would be used in the update-block
    val mRoot = new model2::Root
  }
	update {
    // every Identifiable needs a unique, stable id
    mRoot.id = EcoreUtil.generateUUID()
    // save the newly created Root element at the specified location
    persistProjectRelative(system, mRoot, new File("").toString() + "example.model2")
    // register the correspondence so we can find mRoot later, if we modify something in system and need to adapt mRoot accordingly
		addCorrespondenceBetween(system, mRoot)
	}
}

// a Component is mapped to an Entity in model2.
reaction ComponentInsertedIntoSystem {
  // the brackets [ ] are used to denote a reference inside a metaclass (see model.ecore line 23 in the model project)
	after element model::Component inserted in model::System[components]
	call createAndInsertEntity(affectedEObject, newValue)
}

routine createAndInsertEntity(model::System system, model::Component component) {
	match {
		require absence of model2::Entity corresponding to component
    // retrieve the mRoot we added a correspondence in the createAndRegisterRoot routine in the update block (line 33 in this file)
    val mRoot = retrieve model2::Root corresponding to system
	}
  create {
    val entity = new model2::Entity
  }
	update {
    entity.id = EcoreUtil.generateUUID()
    entity.name = component.name
    mRoot.entities.add(entity)
		addCorrespondenceBetween(component, entity)
	}
}

// we replaced a single-valued attribute value, in this case the name of a component, with a new name.
reaction ComponentRenamed {
	after attribute replaced at model::Component[name]
  // affectedEObject refers to the modified element (provided by the reactions runtime environment at runtime). The change is already applied, so affectedEObject.name is the new name. alternatively, we could use newValue to get the name.
	call renameEntity(affectedEObject)
}

routine renameEntity(model::Component component) {
	match {
    val entity = retrieve model2::Entity corresponding to component
	}
  // we can omit blocks like the update block if we do not need them
	update {
    entity.name = component.name
	}
}

reaction ComponentDeleted {
	after element model::Component deleted
	call deleteEntity(affectedEObject)
}

routine deleteEntity(model::Component component) {
	match {
		val entity = retrieve model2::Entity corresponding to component
	}
	update {
    // remove the corresponding object as well
		removeObject(entity)
    // cleanup of the correspondence model so it does not contain links to invalid, i.e., deleted, model elements
		removeCorrespondenceBetween(entity, component)
	}
}

reaction LinkInsertedIntoSystem {
	after element model::Link inserted in model::System[links]
	call createAndInsertLink(affectedEObject, newValue)
}

routine createAndInsertLink(model::System system, model::Link link) {
	match {
		require absence of model2::Link corresponding to link
		val mRoot = retrieve model2::Root corresponding to system
	}
	create {
		val mLink = new model2::Link
	}
	update {
		mLink.id = EcoreUtil.generateUUID()
		mRoot.links.add(mLink)
		addCorrespondenceBetween(link, mLink)
		// depending on how the change was recorded, a Link may already reference its Protocol when it is inserted,
		// so no separate ProtocolInsertedIntoLink follows; the routine's require-absence guard makes the call a
		// no-op when one does
		if (link.protocol !== null) {
			createStandardForLink(link, link.protocol)
		}
	}
}

reaction ComponentInsertedIntoLink {
	after element model::Component inserted in model::Link[components]
	call updateLinkEntities(affectedEObject, newValue)
}

routine updateLinkEntities(model::Link link, model::Component component) {
	match {
		val mEntity = retrieve model2::Entity corresponding to component
		val mLink = retrieve model2::Link corresponding to link
	}
	update {
		mLink.entities.add(mEntity)
	}
}

reaction ComponentRemovedFromLink {
	after element model::Component removed from model::Link[components]
	call removeEntityFromLink(affectedEObject, oldValue)
}

routine removeEntityFromLink(model::Link link, model::Component component) {
	match {
		val mEntity = retrieve model2::Entity corresponding to component
		val mLink = retrieve model2::Link corresponding to link
	}
	update {
		mLink.entities.remove(mEntity)
	}
}

// A CommunicationStandard can only live inside a model2 Link, as Link[standard] is its sole containment in
// model2. A Protocol on its own therefore has no counterpart there: its standard is created together with the Link
// referencing it and ceases to exist with that Link. Each standard corresponds to that Link, tagged "standard" so
// it can be told apart from the Link's own counterpart, and untagged to the Protocol it stands for - one Protocol
// may have several standards, one per Link referencing it.
reaction ProtocolInsertedIntoLink {
	after element model::Protocol replaced at model::Link[protocol]
	call updateLinkProtocol(affectedEObject, oldValue, newValue)
}

routine updateLinkProtocol(model::Link link, model::Protocol oldProtocol, model::Protocol newProtocol) {
	match {
		val mStandard = retrieve optional model2::CommunicationStandard corresponding to link tagged "standard"
	}
	update {
		if (mStandard.isPresent) {
			val standard = mStandard.get
			if (newProtocol === null) {
				// the Link's protocol was unset: its standard has nothing to stand for anymore. Drop it along with
				// its correspondences (deleteStandard also removes the tagged one to the Link).
				if (oldProtocol !== null) {
					deleteStandard(oldProtocol, standard)
				} else {
					removeCorrespondenceBetween(link, standard, "standard")
					removeObject(standard)
				}
			} else {
				// rename the Link's own standard rather than moving the new Protocol's one into it, which would drop
				// that standard out of its container while correspondences still point at it
				if (oldProtocol !== null) {
					removeCorrespondenceBetween(oldProtocol, standard)
				}
				standard.name = newProtocol.name
				addCorrespondenceBetween(newProtocol, standard)
			}
		} else if (newProtocol !== null) {
			createStandardForLink(link, newProtocol)
		}
	}
}

routine createStandardForLink(model::Link link, model::Protocol protocol) {
	match {
		val mLink = retrieve model2::Link corresponding to link
		require absence of model2::CommunicationStandard corresponding to link tagged "standard"
	}
	create {
		val mStandard = new model2::CommunicationStandard
	}
	update {
		mStandard.id = EcoreUtil.generateUUID()
		mStandard.name = protocol.name
		mLink.standard = mStandard
		addCorrespondenceBetween(link, mStandard, "standard")
		addCorrespondenceBetween(protocol, mStandard)
	}
}

reaction ProtocolRenamed {
	after attribute replaced at model::Protocol[name]
	call renameStandards(affectedEObject)
}

routine renameStandards(model::Protocol protocol) {
	match {
		val mStandards = retrieve many model2::CommunicationStandard corresponding to protocol
	}
	update {
		for (mStandard : mStandards) {
			mStandard.name = protocol.name
		}
	}
}

reaction LinkDeleted {
	after element model::Link deleted
	call deleteLink(affectedEObject)
}

routine deleteLink(model::Link link) {
	match {
		val mLink = retrieve model2::Link corresponding to link
	}
	update {
		detachStandardOfLink(link)
		removeObject(mLink)
		removeCorrespondenceBetween(mLink, link)
	}
}

// Drops the correspondences of the standard contained in the given Link's counterpart, which stops existing along
// with its container: a correspondence to an object that is in no resource is what makes the next change
// propagation fail. Does nothing for a Link without a standard, whose non-optional retrieve then fails.
routine detachStandardOfLink(model::Link link) {
	match {
		val mStandard = retrieve model2::CommunicationStandard corresponding to link tagged "standard"
		val protocol = retrieve optional model::Protocol corresponding to mStandard
	}
	update {
		if (protocol.isPresent) {
			removeCorrespondenceBetween(protocol.get, mStandard)
		}
		removeCorrespondenceBetween(link, mStandard, "standard")
	}
}

reaction ProtocolDeleted {
	after element model::Protocol deleted
	call deleteStandardsOfProtocol(affectedEObject)
}

routine deleteStandardsOfProtocol(model::Protocol protocol) {
	match {
		val mStandards = retrieve many model2::CommunicationStandard corresponding to protocol
	}
	update {
		for (mStandard : mStandards) {
			deleteStandard(protocol, mStandard)
		}
	}
}

routine deleteStandard(model::Protocol protocol, model2::CommunicationStandard mStandard) {
	match {
		val link = retrieve optional model::Link corresponding to mStandard tagged "standard"
	}
	update {
		if (link.isPresent) {
			removeCorrespondenceBetween(link.get, mStandard, "standard")
		}
		removeCorrespondenceBetween(protocol, mStandard)
		removeObject(mStandard)
	}
}